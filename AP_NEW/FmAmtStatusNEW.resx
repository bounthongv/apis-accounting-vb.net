  <data name="TextBox1.Text" xml:space="preserve">
    <value>insert into Caculate_Rpt_Update (Rpt_Id,CLT_Amt)
  select Rpt_Id , STUFF((  select ' '+b.CLT_Amt from Caculate_Rpt b   where b.Rpt_Id = a.Rpt_Id   order by b.cnt for xml path('a'), type).value('.','nvarchar(max)'),1,1,'') As  CLT_Amt      from Caculate_Rpt a where CLT_Amt &lt;&gt;''group by Rpt_Id </value>
  </data>
  <data name="TextBox2.Text" xml:space="preserve">
